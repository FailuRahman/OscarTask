@{
}
@model List<OscarTask.Models.User>

<h2>Interview Form</h2>

   <a asp-action="Create"> Add Form</a>
<table>
    <thead>
        <tr><th>Name</th><th>Gender</th><th>Phone</th><th>Position</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name </td>
                <td>@item.Gender  </td>
                <td>@item.Phone    </td>
                <td>@item.Position       </td>
               

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }

    </tbody>
</table>
